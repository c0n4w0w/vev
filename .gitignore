# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds only variable names and is what
# `cp .env.example .env.local` in the README copies from.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env files
.env*.local
.env

# Development mail capture — never commit captured invitations.
.vev-dev-mail/

# Secrets and key material that are not covered by the .env rules above.
.env.keys
*.key
*.p12
*.pfx

# Database dumps, backups and logs. These can hold real member data.
*.dump
*.backup
*.bak
*.sql.gz
*.log
/supabase/.temp/
/supabase/.branches/

# Local Claude Code state (launch.json stays tracked).
/.claude/settings.local.json
/.claude/worktrees/

# Loose design files and exports at the repository root. Brand assets that
# ship with the app live in public/ and app/.
/*.png
/*.jpg
/*.jpeg
/*.zip
/ting-logo-system/
/TING-logo-system*/

# Unpublished drafts (bounty terms, readiness reports). Kept out of Git until
# they are approved.
/drafts/
