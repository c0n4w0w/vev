# ─────────────────────────────────────────────────────────────────────────────
# Deployment mode
#
# TING runs the same code twice: the real platform, and a showcase deployment
# pointed at a *separate* Supabase project full of fixtures.
#
# Leave TING_MODE unset in production. Absence means production, so a
# deployment that forgets to configure anything gets the safe answer. Demo
# behaviour — seeding, showcase entry links — has to be asked for explicitly.
#
# Server-only on purpose: no NEXT_PUBLIC_ prefix, so it never reaches a browser
# bundle, and it is read at runtime so switching it is a restart, not a rebuild.
#
#   production   (leave unset)
#   demo         TING_MODE=demo
# ─────────────────────────────────────────────────────────────────────────────
# TING_MODE=demo

# Absolute URL of the deployment. Every link the server emails — sign-in and
# invitations — and the redirect after an emailed link is used are built from
# this, so it must match what people actually type.
#
# Set SITE_URL, not NEXT_PUBLIC_SITE_URL. This one is server-only and read at
# runtime, so correcting it needs a restart. NEXT_PUBLIC_* values are baked
# into the bundle by `next build`, which means setting one after building has
# no effect until the next build.
#
# Without it the origin falls back to the Host header, which behind a reverse
# proxy is the upstream address (http://localhost:3010) rather than the site.
SITE_URL=https://join-ting.no

# Honoured if present, for deployments that already set it. Prefer SITE_URL.
# NEXT_PUBLIC_SITE_URL=

# How many reverse proxies of your own stand in front of the app: 1 behind
# nginx alone. Password tries are limited per network address as well as per
# account, and the address is read from X-Forwarded-For that many places from
# the right — the part your proxy wrote, never the part a caller sent. The
# proxy must append the connecting address (nginx: `proxy_set_header
# X-Forwarded-For $proxy_add_x_forwarded_for;`) and the app must not be
# reachable except through it.
#
# Leave unset when nothing is in front (local development): the header is then
# the caller's own word, so no address is trusted and only the per-account
# limit applies.
# TRUSTED_PROXY_COUNT=1

# Server-only, optional. A Supabase *secret* API key (starts with sb_secret_;
# Project settings → API Keys). With it — and TRUSTED_PROXY_COUNT, and "IP
# Address Forwarding" switched on under Authentication → Rate Limits — Supabase
# Auth is told each caller's own network address, so its sign-in, email-link
# and token-refresh limits apply per person instead of to this server as a
# whole. The legacy service_role key does not work for this.
#
# It is as powerful as the service role key. The app sends it only with
# requests to Auth's rate-limited endpoints, never with a query, and never to a
# browser. Create one for this purpose alone so it can be rotated on its own,
# keep it out of the repository, and never give it a NEXT_PUBLIC_ name.
# Unset means no forwarding; everything else works the same.
# SUPABASE_SECRET_KEY=

# Supabase — hosted project (Project settings → API) or `supabase start` output.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development only. Copies every email TING sends (invitations) into the
# local Supabase mail catcher, where the sign-in emails already land, so one
# inbox holds the whole journey. Loopback addresses only; leave unset anywhere
# else.
# LOCAL_MAIL_CATCHER_URL=http://127.0.0.1:54324

# Must equal the Supabase project's email OTP lifetime ("Email OTP Expiration"
# on hosted, auth.email.otp_expiry locally). The approval email states when its
# direct sign-in stops working from this, so a wrong value makes it promise
# something untrue. Unset assumes Supabase's default of one hour.
# SUPABASE_EMAIL_OTP_EXPIRY_SECONDS=3600

# Server-only. Bypasses row level security; used by `npm run seed`. Also used
# on the server to mint the sign-in token in approval emails.
# Never expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Showcase entry links (demo deployment only)
#
# One unguessable token per showcase. Visiting /demo/<token> signs the visitor
# in as that showcase's persona and drops them on its community — no password,
# no email, no signup. The token is the credential, so treat it like one:
# generate it with `openssl rand -base64 32 | tr -d '=+/'`, keep it out of the
# repository, and rotate it by changing the value here and restarting.
#
# All are ignored unless TING_MODE=demo. A production deployment that somehow
# carried these values still refuses every token and answers /demo/* with 404.
#
# Minimum 24 characters; shorter values are rejected rather than accepted.
# ─────────────────────────────────────────────────────────────────────────────
# DEMO_TOKEN_TRYGGERE=
# DEMO_TOKEN_TRYGGERE_MEMBER=
# DEMO_TOKEN_UTR=
# DEMO_TOKEN_UTR_MEMBER=
# DEMO_TOKEN_UTR_ADMIN=
# DEMO_TOKEN_FTR_ADMIN=
# DEMO_TOKEN_TU_ADMIN=
