# Absolute URL of the deployment. Used for the links in sign-in and invitation
# emails, so it must match what people actually visit. Without it those links
# fall back to the proxy's forwarded host.
NEXT_PUBLIC_SITE_URL=https://join-ting.no

# Supabase — hosted project (Project settings → API) or `supabase start` output.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security; used by `npm run seed`.
# Never expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Lets the login screen sign in as the seeded demo accounts with a password.
# Leave unset anywhere real.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
DEMO_ACCOUNT_PASSWORD=vev-demo-passord
